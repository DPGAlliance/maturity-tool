{
  "cases": [
    {
      "id": "github-valid",
      "scenario": "github",
      "label": "GitHub valid public repo",
      "repo_url": "https://github.com/egovernments/DIGIT-OSS",
      "create_scan": true,
      "expect": {
        "provider": "github",
        "provider_family": "github",
        "valid": true,
        "accessible": true,
        "scan_supported": true,
        "result_class": "supported_repo"
      }
    },
    {
      "id": "github-missing",
      "scenario": "github",
      "label": "GitHub missing repo",
      "repo_url": "https://github.com/egovernments/this-repo-should-not-exist-xyz",
      "expect": {
        "provider": "github",
        "provider_family": "github",
        "valid": false,
        "accessible": false,
        "scan_supported": true,
        "result_class": "repo_not_found"
      }
    },
    {
      "id": "gitlab-valid",
